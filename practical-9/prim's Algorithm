#include <iostream>
using namespace std;

int main() {
    int n;

    cout << "Enter number of vertices: ";
    cin >> n;

    int graph[20][20];

    cout << "Enter the adjacency matrix:\n";
    for (int i = 0; i < n; i++)
        for (int j = 0; j < n; j++)
            cin >> graph[i][j];

    int selected[20] = {0};
    selected[0] = 1;

    int edges = 0, total = 0;

    cout << "\nEdges in MST:\n";

    while (edges < n - 1) {
        int min = 9999;
        int x = 0, y = 0;

        for (int i = 0; i < n; i++) {
            if (selected[i]) {
                for (int j = 0; j < n; j++) {
                    if (!selected[j] && graph[i][j] != 0 &&
                        graph[i][j] < min) {
                        min = graph[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        cout << x << " - " << y << " = " << min << endl;

        total += min;
        selected[y] = 1;
        edges++;
    }

    cout << "Total Weight = " << total << endl;

    return 0;
}


