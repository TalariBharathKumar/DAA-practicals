#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int p[] = {1, 2, 5, 6};
    int w[] = {2, 3, 4, 5};

    int n = 4;
    int W = 8;

    int K[n + 1][W + 1];

    for (int i = 0; i <= n; i++) {
        for (int j = 0; j <= W; j++) {

            if (i == 0 || j == 0)
                K[i][j] = 0;

            else if (w[i - 1] <= j)
                K[i][j] = max(
                    p[i - 1] + K[i - 1][j - w[i - 1]],
                    K[i - 1][j]
                );

            else
                K[i][j] = K[i - 1][j];
        }
    }

    cout << "Maximum Profit = " << K[n][W] << endl;

    return 0;
}
Output:
Maximum Profit = 8
